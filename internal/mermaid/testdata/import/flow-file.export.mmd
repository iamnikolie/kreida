%% title: Как команда обрабатывает запросы
%% sub: Ответ отправляется после проверки
%% legend: src Что приходит | core Что делает ассистент | out Результат для команды
flowchart TD
  subgraph S1["Новая запись"]
    direction LR
    a1["Анкета в Telegram<br/>тема, описание, контакты"]:::src
    b1["Заводит карточку<br/>проверяет дубли, раскладывает поля"]:::core
    c1["Запись в базе<br/>+ «не хватает описания»"]:::out
  end
  subgraph S2["Запрос клиента"]
    direction LR
    a2["«3 заявки на проверку»<br/>письмо или сообщение"]:::src
    b2["Подбирает по базе<br/>тема, срок, статус"]:::core
    c2["Шорт-лист<br/>список записей и черновик ответа"]:::out
  end
  subgraph S3["Почта"]
    direction LR
    a3["Входящие письма<br/>вопросы, заявки, обновления"]:::src
    b3["Разбирает и пишет<br/>важное наверх, черновики ответов"]:::core
    c3["Кнопка «Отправить»<br/>в Telegram, одним нажатием"]:::out
  end
  subgraph S4["Каждое утро"]
    direction LR
    a4["Задачи и сроки<br/>проверки, напоминания, ответы"]:::src
    b4["Собирает сводку<br/>что горит, что ждёт ответа"]:::core
    c4["Утренняя сводка<br/>план дня в одном сообщении"]:::out
  end
  a1 --> b1
  b1 --> c1
  a2 --> b2
  b2 --> c2
  a3 --> b3
  b3 --> c3
  a4 --> b4
  b4 --> c4
  S1 ~~~ S2
  S2 ~~~ S3
  S3 ~~~ S4
  classDef src stroke:#4a7fd4,stroke-width:1.6px
  classDef core stroke:#d4943a,stroke-width:1.6px
  classDef out stroke:#4f9a62,stroke-width:1.6px
